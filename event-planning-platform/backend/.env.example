# Copy to .env and adjust. Without a .env the project runs with safe dev defaults (SQLite).
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# Database: set DB_ENGINE=mysql to use MySQL, otherwise SQLite is used.
DB_ENGINE=sqlite
DB_NAME=epp_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

TIME_ZONE=Africa/Lagos
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
