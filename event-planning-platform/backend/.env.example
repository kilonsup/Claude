# Copy to .env and adjust. Without a .env the project runs with safe dev defaults (SQLite).
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=*

# --- Database ---------------------------------------------------------------
# Production: a single connection string wins over everything below. Vercel
# Postgres, Neon, Render and Railway all provide one of these automatically.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL_REQUIRE=True

# Self-hosted MySQL: set DB_ENGINE=mysql (and uncomment mysqlclient in
# requirements.txt). Otherwise SQLite is used for local development.
DB_ENGINE=sqlite
DB_NAME=epp_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Deployment -------------------------------------------------------------
TIME_ZONE=Africa/Lagos

# Only needed when the frontend is hosted on a different domain than the API.
# When both are served from one domain (Vercel Services) requests are
# same-origin and this can be left alone.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Domains trusted for Django admin form posts.
CSRF_TRUSTED_ORIGINS=https://*.vercel.app

# Set to 1 during a deploy to populate demo planners, vendors, events and
# gallery items. Leave unset for a clean production database.
SEED_DEMO_DATA=0
